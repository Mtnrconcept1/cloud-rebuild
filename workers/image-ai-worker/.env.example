# Secrets: keep this file on the worker host only. Never expose the service key to React/Vite.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
WORKER_ID=tok-image-worker-1

# Free, self-hosted inference. Docker Compose overrides this URL to http://ollama:11434.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_KEEP_ALIVE=10m

# Only these server-controlled Storage buckets may be read by the service role.
ALLOWED_STORAGE_BUCKETS=restaurant-images,social-post-media
MAX_IMAGE_BYTES=8388608
EMBEDDING_DIMENSIONS=384

POLL_INTERVAL_MS=5000
BATCH_SIZE=3
DOWNLOAD_TIMEOUT_MS=30000
OLLAMA_VISION_TIMEOUT_MS=300000
OLLAMA_EMBEDDING_TIMEOUT_MS=60000
SUPABASE_TIMEOUT_MS=20000
HTTP_RETRY_ATTEMPTS=3
RETRY_BASE_MS=1000
JOB_RETRY_BASE_MS=5000
HEALTH_PORT=8080

