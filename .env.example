# =============================================================================
# Client (VITE_*)  — bundled into the public JS. NEVER put server secrets here.
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Stripe publishable key only — NEVER the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_RELEASE=tok-web@2026.04.12

# Set to "true" to show the coming-soon page and block public routes pre-launch.
# VITE_COMING_SOON=false

# Firebase Web (public by design; lock down by domain in Firebase Console).
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=0000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_VAPID_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# Local tooling only (supabase CLI, db migrations). Loaded by developers, NOT
# bundled into the client. These must live OUTSIDE the VITE_ namespace.
# =============================================================================
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_DB_PASSWORD=replace-me

# =============================================================================
# Vercel Functions — server-only marketing BFF.
# Never prefix the service-role key with VITE_ and never expose it to the app.
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Edge Function secrets — provision with `supabase secrets set --project-ref ...`.
# Do NOT commit real values. This block is documentation; copy only the names
# you need into the Supabase dashboard or via the CLI.
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# STRIPE_SECRET_KEY=sk_live_xxx
# Primary Stripe webhook signing secret for the endpoint URL.
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional second signing secret when two Stripe webhook destinations point to
# the same Supabase function URL during a migration or dashboard overlap.
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_xxx
# INTERNAL_CRON_SECRET=replace-with-long-random-secret
# Dedicated HMAC secret for the internal marketing provider-event adapter.
# Keep it distinct from INTERNAL_CRON_SECRET and rotate it independently.
# MARKETING_WEBHOOK_SECRET=replace-with-another-long-random-secret
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# RESEND_API_KEY=re_xxx
# Required in production for `send-email`; without it queued emails now fail closed.
# EMAIL_FROM=Tok <noreply@example.com>
# APP_BASE_URL=https://app.thetok.ch
# PUBLIC_APP_URL=https://www.thetok.ch
# SITE_URL=https://www.thetok.ch
# ALLOWED_ORIGINS=https://www.thetok.ch,https://thetok.ch,https://app.thetok.ch,https://admin.thetok.ch,https://marketing.thetok.ch,https://commercial.thetok.ch,https://cloud-rebuild-recovered.vercel.app
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# FIRECRAWL_API_KEY=fc_xxx
