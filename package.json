{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.28.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production && node ./scripts/prerender-seo.mjs",
    "seo:prerender": "node ./scripts/prerender-seo.mjs",
    "seo:sitemap": "node ./scripts/prerender-seo.mjs --public-only",
    "deploy:vercel:prod": "node ./scripts/write-production-env.mjs --out=.env.production.local && npx vercel@latest pull --yes --environment=production && npx vercel@latest --prod",
    "deploy:postcheck": "node ./scripts/post-deploy-check.mjs",
    "lint": "eslint .",
    "lint:release": "eslint src/App.tsx src/pages/TokOne.tsx supabase/functions/create-checkout/index.ts supabase/functions/stripe-webhook/index.ts supabase/functions/manage-tok-one-subscription/index.ts supabase/functions/manage-restaurant-subscription/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "preview": "vite preview",
    "preview:prod": "pnpm run build:prod && vite preview --mode production",
    "test": "vitest run",
    "test:launch:10k": "node ./scripts/launch-10k-load-check.mjs",
    "check:frontend:10k": "node ./scripts/frontend-10k-readiness.mjs",
    "test:prod": "vitest run --mode production",
    "test:watch": "vitest",
    "release:readiness": "node ./scripts/release-readiness.mjs",
    "release:readiness:strict": "node ./scripts/release-readiness.mjs --strict",
    "scale:readiness": "node ./scripts/scale-readiness-check.mjs",
    "google:actions:feeds": "node ./scripts/google-actions-center-export-feeds.mjs",
    "supabase:doctor": "node ./scripts/supabase-doctor.mjs",
    "supabase:doctor:prod": "node ./scripts/supabase-doctor.mjs --mode=production",
    "supabase:doctor:all": "node ./scripts/supabase-doctor.mjs --mode=all",
    "supabase:target:dev": "node ./scripts/supabase-target.mjs --mode=development",
    "supabase:target:prod": "node ./scripts/supabase-target.mjs --mode=production",
    "supabase:db:push:dev": "node ./scripts/supabase-db-push.mjs --mode=development",
    "supabase:db:push:prod": "node ./scripts/supabase-db-push.mjs --mode=production",
    "git:auto-sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/git-auto-sync.ps1 -Once",
    "git:auto-sync:main": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/git-auto-sync.ps1 -Once -Branch main",
    "git:auto-sync:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/git-auto-sync.ps1 -Loop -Branch main -IntervalSeconds 300",
    "git:auto-sync:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-git-auto-sync-task.ps1",
    "git:auto-sync:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-git-auto-sync-task.ps1 -Uninstall",
    "cap:sync": "pnpm exec cap sync",
    "cap:build": "pnpm run build && pnpm exec cap sync",
    "cap:ios": "pnpm run build && pnpm exec cap sync ios && pnpm exec cap open ios",
    "cap:android": "pnpm run build && pnpm exec cap sync android && pnpm exec cap open android",
    "cap:dev:ios": "pnpm run build:dev && pnpm exec cap sync ios && pnpm exec cap open ios",
    "cap:dev:android": "pnpm run build:dev && pnpm exec cap sync android && pnpm exec cap open android",
    "mobile:sync": "pnpm run build && pnpm exec cap sync android ios",
    "mobile:build:android:debug": "node ./scripts/mobile-verify.mjs android-debug",
    "mobile:build:android:release": "node ./scripts/mobile-verify.mjs android-release",
    "mobile:build:android:bundle": "node ./scripts/mobile-verify.mjs android-bundle",
    "mobile:build:ios:release": "node ./scripts/mobile-verify.mjs ios-release",
    "mobile:android:readiness": "node ./scripts/mobile-verify.mjs android-readiness",
    "mobile:ios:readiness": "node ./scripts/mobile-verify.mjs ios-readiness",
    "mobile:playstore:check": "pnpm run mobile:android:readiness && pnpm run build",
    "mobile:appstore:check": "pnpm run mobile:ios:readiness && pnpm run build",
    "mobile:verify": "node ./scripts/mobile-verify.mjs verify"
  },
