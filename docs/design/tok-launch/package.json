{
  "name": "tok-launch-motion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178",
    "build": "tsc --noEmit && vite build",
    "studio": "remotion studio src/remotion.tsx",
    "render": "remotion render src/remotion.tsx TokLaunch out/tok-launch.mp4 --codec h264 --crf 18 --concurrency 2",
    "still": "remotion still src/remotion.tsx TokLaunch out/tok-launch.png --frame 90",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "8.3.4"
  }
}
